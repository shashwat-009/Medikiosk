# ============================================================
# MediSetu — Production Environment Variables Template
# Copy this file to .env and replace placeholder values.
# DO NOT commit real secrets or production keys to version control.
# ============================================================

# ------------------------------------------------------------
# General Application Settings
# ------------------------------------------------------------
APP_NAME=MediSetu
APP_VERSION=0.2.0

# ------------------------------------------------------------
# Database Configuration
# SQLite local file path or PostgreSQL connection string
# Example SQLite: sqlite:////app/data/medisetu.db
# Example Postgres: postgresql://postgres:password@postgres:5432/medisetu
# ------------------------------------------------------------
DATABASE_URL=sqlite:////app/data/medisetu.db

# ------------------------------------------------------------
# Microservice Internal URLs (Docker network service names)
# ------------------------------------------------------------
OCR_SERVICE_URL=http://ocr-service:8001
SEMANTIC_SERVICE_URL=http://semantic-service:8002

# ------------------------------------------------------------
# Authentication & Security
# Generate a secure 32+ character key for JWT signing:
# openssl rand -hex 32
# ------------------------------------------------------------
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# ------------------------------------------------------------
# Sarvam AI ASR (Indic Speech-to-Text)
# Obtain key from https://www.sarvam.ai/
# If left empty or 'mock', the system automatically uses MockASRProvider
# ------------------------------------------------------------
SARVAM_API_KEY=your_sarvam_api_key_here

# ------------------------------------------------------------
# Supabase Storage (Medical Documents & Images)
# Obtain from your Supabase project settings -> API
# ------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_secret_key
